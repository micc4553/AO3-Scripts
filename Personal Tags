// ==UserScript==
// @name         AO3 Personal Tags (Local)
// @namespace    local.ao3.personal-tags
// @version      2.0.2
// @description  Local personal tags, autocomplete, custom tag links, and personal tag browsing.
// @match        https://archiveofourown.org/*
// @icon         https://archiveofourown.org/favicon.ico
// @grant        none
// @run-at       document-end
// ==/UserScript==

(function () {
    'use strict';

    const DB_NAME = 'AO3DB';
    const STORE_NAME = 'data';
    const KEYS = {
        PERSONAL_TAGS: 'ao3_personal_tags',
        TAG_LOOKUP: 'ao3_tag_lookup',
        TAG_LINKS: 'ao3_tag_links'
    };

    const $ = (selector, root = document) => root.querySelector(selector);
    const $$ = (selector, root = document) => Array.from(root.querySelectorAll(selector));
    const normalizeTag = tag => String(tag || '').trim().toLowerCase();
    const DEFAULT_LINK = tag => `https://archiveofourown.org/tags/${encodeURIComponent(tag)}/works`;

    function normalizeWorkId(value) {
        const match = String(value ?? '').match(/\d+/);
        return match ? match[0] : null;
    }

    function safeURL(value) {
        if (typeof value !== 'string' || !value.trim()) return null;
        try {
            const url = new URL(value, location.origin);
            return ['http:', 'https:'].includes(url.protocol) ? url.href : null;
        } catch {
            return null;
        }
    }

    function create(tagName, options = {}, text) {
        const el = document.createElement(tagName);
        for (const [key, value] of Object.entries(options)) {
            if (key === 'class') el.className = value;
            else if (key === 'style') el.style.cssText = value;
            else if (key.startsWith('data-')) el.setAttribute(key, value);
            else if (key in el) el[key] = value;
            else el.setAttribute(key, value);
        }
        if (text !== undefined) el.textContent = text;
        return el;
    }

    function addStyles() {
        if ($('#ao3-personal-tags-styles')) return;
        const style = create('style', { id: 'ao3-personal-tags-styles' });
        style.textContent = `
            .ao3pt-chip { display:inline-flex; align-items:center; gap:4px; margin:2px 6px 2px 0; }
            .ao3pt-link { color:inherit; text-decoration:none; }
            .ao3pt-link:hover { color:#e8c8dc; text-decoration:underline; text-decoration-color:#c4a7e7; text-underline-offset:3px; }
            .ao3pt-remove { background:none!important; border:0!important; box-shadow:none!important; color:#777; cursor:pointer; padding:0 2px; font-weight:bold; }
            .ao3pt-remove:hover { color:#fff; }
            .ao3pt-panel { box-sizing:border-box; width:300px; max-width:calc(100vw - 32px); margin-top:8px; padding:10px; background:#2a273f; border:1px solid #777; border-radius:5px; position:relative; z-index:1001; overflow-x:hidden; }
            .ao3pt-suggestions { box-sizing:border-box; width:100%; max-height:160px; overflow-y:auto; overflow-x:hidden; margin:5px 0; background:#211f32; border:1px solid #777; border-radius:4px; }
            .ao3pt-suggestion { box-sizing:border-box; display:block; width:100%; max-width:100%; text-align:left; white-space:normal; overflow-wrap:anywhere; padding:6px 8px; background:transparent; color:#fff; border:0; cursor:pointer; }
            .ao3pt-suggestion:hover, .ao3pt-suggestion[aria-selected="true"] { background:#514b70; }
            .ao3pt-action { padding:5px 9px; color:#fff; background:#44415a; border:1px solid #777; border-radius:4px; cursor:pointer; transition:background-color .15s,border-color .15s; }
            .ao3pt-action:hover { background:#514b70; border-color:#c4a7e7; }
            .ao3pt-action:focus-visible, .ao3pt-tag-link:focus-visible { outline:2px solid #c4a7e7; outline-offset:2px; }
            .ao3pt-overlay { position:fixed; inset:0; z-index:100000; display:flex; align-items:center; justify-content:center; padding:20px; background:rgba(0,0,0,.7); }
            .ao3pt-modal { box-sizing:border-box; width:min(550px,90vw); max-height:min(700px,80vh); overflow:auto; padding:16px; color:#fff; background:#232136CC; border:1px solid #ddd; border-radius:8px; font:14px sans-serif; box-shadow:0 8px 24px rgba(0,0,0,.3); }
            .ao3pt-modal h3 { margin:0 0 16px; color:#fff; font-size:1.15rem; font-weight:600; }
            .ao3pt-modal a { color:inherit; }
            .ao3pt-tag-list { display:flex; flex-direction:column; gap:6px; }
            .ao3pt-tag-label { display:flex; align-items:baseline; gap:6px; min-width:0; flex:1; flex-wrap:wrap; }
            .ao3pt-tag-count { color:#b8b5c9; font-size:.9em; white-space:nowrap; }
            .ao3pt-tag-row { box-sizing:border-box; display:flex; align-items:center; justify-content:space-between; gap:10px; width:100%; padding:8px 10px; background:#44415a40; border:1px solid transparent; border-radius:5px; transition:background-color .15s,border-color .15s; }
            .ao3pt-tag-row:hover { background:#514b70; border-color:#6e6a86; }
            .ao3pt-tag-link { display:inline-block; max-width:100%; color:#fff!important; text-decoration:none!important; text-underline-offset:3px; overflow-wrap:anywhere; }
            .ao3pt-modal .ao3pt-tag-link:hover { color:#e8c8dc!important; text-decoration:underline!important; text-decoration-color:#c4a7e7!important; }
            .ao3pt-edit-link { flex:0 0 auto; min-width:34px; padding:5px 8px; line-height:1; }
            .ao3pt-listing { margin:4px 0 0; padding:0; list-style:none; }
            .ao3pt-listing li { display:inline; margin-right:8px; }
            .ao3pt-tag-section { border:1px solid #777; border-radius:6px; margin:0 0 14px; overflow:hidden; }
            .ao3pt-tag-header { width:100%; display:flex; justify-content:space-between; gap:10px; text-align:left; padding:10px; border:0; color:inherit; background:#44415a40; cursor:pointer; font-weight:bold; transition:background-color .15s; }
            .ao3pt-tag-header:hover { background:#514b70; }
            .ao3pt-tag-content { display:none; padding:10px; }
            .ao3pt-work-card { margin:8px 0; padding:9px; border-left:3px solid #8b7db8; background:#2a273f; border-radius:4px; }
            .ao3pt-work-card p { margin:5px 0 0; }
        `;
        document.head.appendChild(style);
    }

    // Direct IndexedDB access; no stale in-memory data cache.
    class LocalStore {
        static dbPromise = null;

        static db() {
            if (!this.dbPromise) {
                this.dbPromise = new Promise((resolve, reject) => {
                    const request = indexedDB.open(DB_NAME);
                    request.onupgradeneeded = event => {
                        const db = event.target.result;
                        if (!db.objectStoreNames.contains(STORE_NAME)) {
                            db.createObjectStore(STORE_NAME, { keyPath: 'key' });
                        }
                    };
                    request.onsuccess = () => resolve(request.result);
                    request.onerror = () => reject(request.error || new Error('Could not open AO3DB.'));
                    request.onblocked = () => reject(new Error('Opening AO3DB is blocked by another tab.'));
                });
            }
            return this.dbPromise;
        }

        static async get(key, fallback = {}) {
            const db = await this.db();
            return new Promise((resolve, reject) => {
                const tx = db.transaction(STORE_NAME, 'readonly');
                const request = tx.objectStore(STORE_NAME).get(key);
                request.onsuccess = () => resolve(request.result?.value ?? fallback);
                request.onerror = () => reject(request.error || new Error(`Could not read ${key}.`));
            });
        }

        static async set(key, value) {
            const db = await this.db();
            return new Promise((resolve, reject) => {
                const tx = db.transaction(STORE_NAME, 'readwrite');
                tx.objectStore(STORE_NAME).put({ key, value });
                tx.oncomplete = () => resolve();
                tx.onerror = () => reject(tx.error || new Error(`Could not save ${key}.`));
                tx.onabort = () => reject(tx.error || new Error(`Save aborted for ${key}.`));
            });
        }

        // Update related records in one transaction, so tag membership and lookup stay aligned.
        static async update(keys, updater) {
            const db = await this.db();
            return new Promise((resolve, reject) => {
                const tx = db.transaction(STORE_NAME, 'readwrite');
                const store = tx.objectStore(STORE_NAME);
                const values = {};
                let remaining = keys.length;
                let failure = null;
                let settled = false;

                const fail = error => {
                    if (settled) return;
                    settled = true;
                    failure = error;
                    try { tx.abort(); } catch {}
                    reject(error);
                };

                tx.oncomplete = () => {
                    if (!settled) {
                        settled = true;
                        resolve(values);
                    }
                };
                tx.onerror = () => {
                    if (!settled) {
                        settled = true;
                        reject(tx.error || new Error('Database update failed.'));
                    }
                };
                tx.onabort = () => {
                    if (!settled) {
                        settled = true;
                        reject(failure || tx.error || new Error('Database update aborted.'));
                    }
                };

                for (const key of keys) {
                    const request = store.get(key);
                    request.onsuccess = () => {
                        values[key] = request.result?.value ?? {};
                        remaining--;
                        if (remaining !== 0) return;

                        try {
                            const changes = updater(values) || {};
                            for (const [changedKey, value] of Object.entries(changes)) {
                                store.put({ key: changedKey, value });
                                values[changedKey] = value;
                            }
                        } catch (error) {
                            fail(error);
                        }
                    };
                    request.onerror = () => fail(request.error || new Error(`Could not read ${key}.`));
                }
            });
        }
    }

    async function getPersonalTags(workId) {
        const all = await LocalStore.get(KEYS.PERSONAL_TAGS, {});
        const tags = all[workId];
        return Array.isArray(tags) ? tags : [];
    }

    async function getAllUsedTags() {
        const all = await LocalStore.get(KEYS.PERSONAL_TAGS, {});
        const byNormalizedName = new Map();
        for (const tags of Object.values(all)) {
            if (!Array.isArray(tags)) continue;
            for (const tag of tags) {
                const name = String(tag || '').trim();
                const normalized = normalizeTag(name);
                if (normalized && !byNormalizedName.has(normalized)) {
                    byNormalizedName.set(normalized, name);
                }
            }
        }
        return [...byNormalizedName.values()].sort((a, b) => a.localeCompare(b));
    }

    async function getTagLink(tag, links) {
        const normalized = normalizeTag(tag);
        const savedLinks = links || await LocalStore.get(KEYS.TAG_LINKS, {});
        return safeURL(savedLinks[normalized]) || DEFAULT_LINK(tag);
    }

    function getWorkInfo() {
        const match = location.pathname.match(/\/works\/(\d+)/);
        const id = match?.[1];
        if (!id) return null;

        const title = $('.title.heading')?.textContent.trim()
            || $('h2.title')?.textContent.trim()
            || $('h2.title.heading')?.textContent.trim()
            || '';
        const author = $('.byline.heading a[rel="author"]')?.textContent.trim()
            || $('.preface .byline a[rel="author"]')?.textContent.trim()
            || '';
        const summary = $('.summary blockquote')?.textContent.trim()
            || $('.summary .userstuff')?.textContent.trim()
            || '';
        return { id, title, author: author || 'Anonymous', summary };
    }

    async function changeWorkTag(workInfo, inputTag, shouldAdd) {
        const tagName = String(inputTag || '').trim();
        const normalized = normalizeTag(tagName);
        if (!workInfo?.id || !normalized) return;

        await LocalStore.update([KEYS.PERSONAL_TAGS, KEYS.TAG_LOOKUP], values => {
            const personalTags = values[KEYS.PERSONAL_TAGS] || {};
            const lookup = values[KEYS.TAG_LOOKUP] || {};
            let tags = Array.isArray(personalTags[workInfo.id]) ? [...personalTags[workInfo.id]] : [];
            const existing = tags.find(tag => normalizeTag(tag) === normalized);

            if (shouldAdd) {
                if (!existing) tags.push(tagName);
                personalTags[workInfo.id] = tags;
                lookup[normalized] ||= {};
                lookup[normalized][workInfo.id] = {
                    title: workInfo.title || 'Untitled Work',
                    author: workInfo.author || 'Anonymous',
                    summary: workInfo.summary || ''
                };
            } else {
                tags = tags.filter(tag => normalizeTag(tag) !== normalized);
                if (tags.length) personalTags[workInfo.id] = tags;
                else delete personalTags[workInfo.id];

                if (lookup[normalized]) {
                    delete lookup[normalized][workInfo.id];
                    if (!Object.keys(lookup[normalized]).length) delete lookup[normalized];
                }
            }

            return {
                [KEYS.PERSONAL_TAGS]: personalTags,
                [KEYS.TAG_LOOKUP]: lookup
            };
        });
    }

    function makeLink(tag, href) {
        const link = create('a', {
            class: 'ao3pt-link',
            href,
            target: '_blank',
            rel: 'noopener noreferrer'
        }, tag);
        return link;
    }

    async function addTagsToWorkPage() {
        const workInfo = getWorkInfo();
        const workMeta = $('dl.work.meta.group');
        if (!workInfo || !workMeta || $('.personal-tags-meta')) return;

        const dt = create('dt', { class: 'freeform tags personal-tags-meta' }, 'Personal Tags:');
        const dd = create('dd', { class: 'freeform tags personal-tags-meta' });
        const tagsList = create('ul', { class: 'commas ao3pt-work-tags', style: 'position:relative;' });
        const controls = create('div', { class: 'ao3pt-controls', style: 'margin-top:6px;' });
        const plus = create('button', { type: 'button', class: 'ao3pt-action' }, '+ Add personal tag');
        plus.style.cssText += 'background:#2a273f;color:#fff;';
        controls.appendChild(plus);

        const editor = create('div', { class: 'ao3pt-panel', style: 'display:none;' });
        const input = create('input', {
            type: 'text',
            placeholder: 'Type a personal tag…',
            style: 'box-sizing:border-box;width:100%;padding:7px;background:#211f32;color:#fff;border:1px solid #777;border-radius:4px;'
        });
        const suggestions = create('div', { class: 'ao3pt-suggestions', style: 'display:none;' });
        const actions = create('div', { style: 'display:flex;gap:6px;justify-content:flex-end;' });
        const add = create('button', { type: 'button', class: 'ao3pt-action' }, 'Add');
        const cancel = create('button', { type: 'button', class: 'ao3pt-action' }, 'Cancel');
        for (const btn of [add, cancel]) btn.style.cssText += 'background:#44415a;color:#fff;';
        actions.append(add, cancel);
        editor.append(input, suggestions, actions);
        dd.append(tagsList, controls, editor);

        const additionalTags = $('dd.freeform.tags', workMeta);
        const stats = $('dt.stats', workMeta);
        if (additionalTags?.nextElementSibling) {
            additionalTags.parentNode.insertBefore(dt, additionalTags.nextElementSibling);
            dt.parentNode.insertBefore(dd, dt.nextElementSibling);
        } else if (stats) {
            workMeta.insertBefore(dt, stats);
            workMeta.insertBefore(dd, stats);
        } else {
            workMeta.append(dt, dd);
        }

        async function renderTags() {
            const [tags, links] = await Promise.all([
                getPersonalTags(workInfo.id),
                LocalStore.get(KEYS.TAG_LINKS, {})
            ]);
            tagsList.replaceChildren();

            for (const tag of tags) {
                const li = create('li', { class: 'ao3pt-chip' });
                const href = await getTagLink(tag, links);
                const link = create('a', { class: 'tag ao3pt-link', href }, tag);
                const remove = create('button', {
                    type: 'button', class: 'ao3pt-remove', title: `Remove ${tag}`,
                    'aria-label': `Remove personal tag ${tag}`
                }, '×');

                remove.addEventListener('click', async event => {
                    event.preventDefault();
                    event.stopPropagation();
                    remove.disabled = true;
                    try {
                        await changeWorkTag(workInfo, tag, false);
                        await renderTags();
                    } catch (error) {
                        console.error('[AO3 Personal Tags] Could not remove tag:', error);
                        alert('Could not remove this personal tag. Check the console for details.');
                        remove.disabled = false;
                    }
                });

                li.append(link, remove);
                tagsList.appendChild(li);
            }
        }

        let knownTags = [];
        let selectedIndex = -1;

        function hideEditor() {
            editor.style.display = 'none';
            suggestions.style.display = 'none';
            input.value = '';
            selectedIndex = -1;
        }

        async function addTag(tag) {
            const cleanTag = String(tag || '').trim();
            if (!cleanTag) return;
            try {
                await changeWorkTag(workInfo, cleanTag, true);
                hideEditor();
                await renderTags();
            } catch (error) {
                console.error('[AO3 Personal Tags] Could not add tag:', error);
                alert('Could not save this personal tag. Check the console for details.');
            }
        }

        function chooseSuggestion(index) {
            const item = suggestions.children[index];
            if (item) addTag(item.dataset.tag);
        }

        function renderSuggestions() {
            const query = normalizeTag(input.value);
            suggestions.replaceChildren();
            selectedIndex = -1;
            if (!query) {
                suggestions.style.display = 'none';
                return;
            }

            const matches = knownTags.filter(tag => {
                const normalized = normalizeTag(tag);
                return normalized.includes(query) && normalized !== query;
            });

            if (!matches.length) {
                suggestions.style.display = 'none';
                return;
            }

            matches.slice(0, 30).forEach((tag, index) => {
                const item = create('button', {
                    type: 'button', class: 'ao3pt-suggestion', 'data-tag': tag,
                    'aria-selected': 'false'
                }, tag);
                item.addEventListener('mouseenter', () => {
                    selectedIndex = index;
                    updateSuggestionSelection();
                });
                item.addEventListener('click', () => addTag(tag));
                suggestions.appendChild(item);
            });
            suggestions.style.display = 'block';
        }

        function updateSuggestionSelection() {
            $$('.ao3pt-suggestion', suggestions).forEach((item, index) => {
                item.setAttribute('aria-selected', index === selectedIndex ? 'true' : 'false');
            });
        }

        plus.addEventListener('click', async () => {
            editor.style.display = 'block';
            knownTags = await getAllUsedTags();
            input.focus();
            renderSuggestions();
        });
        cancel.addEventListener('click', hideEditor);
        add.addEventListener('click', () => addTag(input.value));
        input.addEventListener('input', renderSuggestions);
        input.addEventListener('keydown', event => {
            const items = $$('.ao3pt-suggestion', suggestions);
            if (event.key === 'Escape') {
                hideEditor();
            } else if (event.key === 'ArrowDown' && items.length) {
                event.preventDefault();
                selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
                updateSuggestionSelection();
            } else if (event.key === 'ArrowUp' && items.length) {
                event.preventDefault();
                selectedIndex = Math.max(selectedIndex - 1, 0);
                updateSuggestionSelection();
            } else if (event.key === 'Enter') {
                event.preventDefault();
                if (selectedIndex >= 0) chooseSuggestion(selectedIndex);
                else addTag(input.value);
            }
        });

        document.addEventListener('click', event => {
            if (!dd.contains(event.target)) hideEditor();
        });

        await renderTags();
    }

    async function buildTagSummaries() {
        const [personalTags, links] = await Promise.all([
            LocalStore.get(KEYS.PERSONAL_TAGS, {}),
            LocalStore.get(KEYS.TAG_LINKS, {})
        ]);
        const summaries = new Map();
        for (const [workId, tags] of Object.entries(personalTags)) {
            if (!Array.isArray(tags)) continue;
            for (const tag of tags) {
                const normalized = normalizeTag(tag);
                if (!normalized) continue;
                if (!summaries.has(normalized)) summaries.set(normalized, { name: tag, works: [], count: 0 });
                const item = summaries.get(normalized);
                item.count++;
                item.works.push(workId);
            }
        }
        return { summaries, links };
    }

    async function addPersonalTagsToSearchResults(root = document) {
        const blurbs = $$('.work.blurb, li.bookmark.blurb', root);
        if (!blurbs.length) return;
        const all = await LocalStore.get(KEYS.PERSONAL_TAGS, {});
        const links = await LocalStore.get(KEYS.TAG_LINKS, {});

        for (const blurb of blurbs) {
            if (blurb.querySelector('.personal-tags-added')) continue;
            const workLink = $('h4.heading a[href*="/works/"]', blurb) || $('a[href*="/works/"]', blurb);
            const workId = normalizeWorkId(workLink?.href || '');
            if (!workId) continue;
            const tags = Array.isArray(all[workId]) ? all[workId] : [];
            if (!tags.length) continue;

            const personalList = create('ul', { class: 'tags commas personal-tags-added ao3pt-listing' });
            const label = create('li', { style: 'display:inline;color:#999;font-style:italic;margin-right:6px;' }, 'Personal tags:');
            personalList.appendChild(label);

            for (const tag of tags) {
                const li = create('li');
                li.appendChild(makeLink(tag, await getTagLink(tag, links)));
                personalList.appendChild(li);
            }

            const existingTags = $('ul.tags', blurb);
            if (existingTags?.parentNode) existingTags.parentNode.insertBefore(personalList, existingTags.nextSibling);
            else {
                const stats = $('dl.stats', blurb);
                if (stats?.parentNode) stats.parentNode.insertBefore(personalList, stats.nextSibling);
            }
        }
    }

    function canonicalTagName(normalized, allPersonalTags) {
        for (const tags of Object.values(allPersonalTags)) {
            if (Array.isArray(tags)) {
                const found = tags.find(tag => normalizeTag(tag) === normalized);
                if (found) return found;
            }
        }
        return normalized;
    }

    function urlsMatch(custom, current) {
        const customURL = safeURL(custom);
        if (!customURL) return false;
        try {
            const a = new URL(customURL);
            const b = new URL(current);
            return a.origin === b.origin &&
                a.pathname.replace(/\/$/, '') === b.pathname.replace(/\/$/, '') &&
                (a.search === b.search || !a.search);
        } catch {
            return false;
        }
    }

    async function addPersonalWorksToTagPage() {
        const match = location.pathname.match(/\/tags\/([^/]+)\/works/);
        if (!match) return;

        const [lookup, links, personalTags] = await Promise.all([
            LocalStore.get(KEYS.TAG_LOOKUP, {}),
            LocalStore.get(KEYS.TAG_LINKS, {}),
            LocalStore.get(KEYS.PERSONAL_TAGS, {})
        ]);

        const tagNameFromURL = decodeURIComponent(match[1]).replace(/_/g, ' ');
        const directNormalized = normalizeTag(tagNameFromURL);
        const tagsToShow = new Map();

        if (lookup[directNormalized] && Object.keys(lookup[directNormalized]).length) {
            tagsToShow.set(directNormalized, { works: lookup[directNormalized] });
        }

        for (const [normalized, customLink] of Object.entries(links)) {
            if (urlsMatch(customLink, location.href) && lookup[normalized] && Object.keys(lookup[normalized]).length) {
                tagsToShow.set(normalized, { works: lookup[normalized] });
            }
        }

        if (!tagsToShow.size) return;

        const worksList = $('ol.work.index.group') || $('#main ol.index.group') || $('#main .index.group') || $('ol.work.index');
        if (!worksList?.parentNode || $('#personal-tags-section')) return;

        const main = create('div', { id: 'personal-tags-section', style: 'margin:15px 0;' });

        for (const [normalized, info] of tagsToShow) {
            const tagName = canonicalTagName(normalized, personalTags);
            const section = create('section', { class: 'ao3pt-tag-section' });
            const header = create('button', { type: 'button', class: 'ao3pt-tag-header' });
            const headerText = create('span', {}, `📌 Your Personal “${tagName}” Tag`);
            const count = create('span', {}, `${Object.keys(info.works).length} works ▸`);
            header.append(headerText, count);

            const content = create('div', { class: 'ao3pt-tag-content' });
            const works = Object.entries(info.works).sort((a, b) => {
                const aId = Number(a[0]) || 0;
                const bId = Number(b[0]) || 0;
                return bId - aId;
            });

            for (const [workId, work] of works) {
                const card = create('div', { class: 'ao3pt-work-card' });
                const title = create('a', { href: `/works/${encodeURIComponent(workId)}` }, work?.title || `Work ${workId}`);
                const titleLine = create('h4', { style: 'margin:0 0 5px;' });
                titleLine.appendChild(title);
                const author = create('p', { style: 'color:#aaa;font-size:.9em;' }, `by ${work?.author?.trim() || 'Anonymous'}`);
                card.append(titleLine, author);
                if (work?.summary?.trim()) {
                    const summary = work.summary.trim();
                    card.appendChild(create('p', {}, summary.length > 250 ? `${summary.slice(0, 250)}…` : summary));
                }
                content.appendChild(card);
            }

            header.addEventListener('click', () => {
                const expanded = content.style.display === 'block';
                content.style.display = expanded ? 'none' : 'block';
                count.textContent = `${Object.keys(info.works).length} works ${expanded ? '▸' : '▾'}`;
            });

            section.append(header, content);
            main.appendChild(section);
        }

        worksList.parentNode.insertBefore(main, worksList);
    }

    function openOverlay(title) {
        const overlay = create('div', { class: 'ao3pt-overlay' });
        const modal = create('div', { class: 'ao3pt-modal' });
        const heading = create('h3', {}, title);
        modal.appendChild(heading);
        overlay.appendChild(modal);
        overlay.addEventListener('click', event => {
            if (event.target === overlay) overlay.remove();
        });
        document.body.appendChild(overlay);
        return { overlay, modal };
    }

    async function editTagLink(tag, onSaved) {
        const links = await LocalStore.get(KEYS.TAG_LINKS, {});
        const normalized = normalizeTag(tag);
        const { overlay, modal } = openOverlay(`Edit link for “${tag}”`);
        const input = create('input', {
            type: 'url',
            value: await getTagLink(tag, links),
            style: 'box-sizing:border-box;width:100%;padding:8px;margin:8px 0 14px;background:#211f32;color:#fff;border:1px solid #777;border-radius:4px;'
        });
        input.placeholder = 'https://…';
        const controls = create('div', { style: 'display:flex;justify-content:flex-end;gap:8px;flex-wrap:wrap;' });
        const reset = create('button', { type: 'button', class: 'ao3pt-action' }, 'Reset to default');
        const save = create('button', { type: 'button', class: 'ao3pt-action' }, 'Save');
        const cancel = create('button', { type: 'button', class: 'ao3pt-action' }, 'Cancel');
        reset.addEventListener('click', () => { input.value = DEFAULT_LINK(tag); });
        cancel.addEventListener('click', () => overlay.remove());
        save.addEventListener('click', async () => {
            const href = safeURL(input.value.trim());
            if (!href || !/^https?:\/\//i.test(href)) {
                alert('Please enter a valid http or https URL.');
                return;
            }
            const current = await LocalStore.get(KEYS.TAG_LINKS, {});
            current[normalized] = href;
            await LocalStore.set(KEYS.TAG_LINKS, current);
            overlay.remove();
            if (onSaved) await onSaved();
        });
        input.addEventListener('keydown', event => {
            if (event.key === 'Enter') save.click();
            if (event.key === 'Escape') overlay.remove();
        });
        controls.append(reset, save, cancel);
        modal.append(input, controls);
        input.focus();
        input.select();
    }

    async function showPersonalTagsModal() {
        const { overlay, modal } = openOverlay('📌 Your Personal Tags');
        const loading = create('p', {}, 'Loading your tags…');
        modal.appendChild(loading);

        try {
            const { summaries } = await buildTagSummaries();
            loading.remove();
            if (!summaries.size) {
                modal.appendChild(create('p', {}, 'No personal tags yet. Add one from an AO3 work page.'));
                return;
            }

            const list = create('div', { class: 'ao3pt-tag-list' });
            const entries = [...summaries.entries()].sort((a, b) => a[1].name.localeCompare(b[1].name));
            for (const [normalized, item] of entries) {
                const row = create('div', { class: 'ao3pt-tag-row' });
                const label = create('div', { class: 'ao3pt-tag-label' });
                const link = create('a', {
                    class: 'ao3pt-tag-link',
                    href: await getTagLink(item.name),
                    target: '_blank',
                    rel: 'noopener noreferrer'
                }, item.name);
                const count = create('span', { class: 'ao3pt-tag-count' }, `(${item.count})`);
                const edit = create('button', {
                    type: 'button',
                    class: 'ao3pt-action ao3pt-edit-link',
                    title: `Edit custom link for ${item.name}`,
                    'aria-label': `Edit custom link for ${item.name}`
                }, '⚙');
                edit.addEventListener('click', () => editTagLink(item.name, async () => {
                    overlay.remove();
                    await showPersonalTagsModal();
                }));
                label.append(link, count);
                row.append(label, edit);
                list.appendChild(row);
            }
            modal.appendChild(list);
        } catch (error) {
            console.error('[AO3 Personal Tags] Could not load tag list:', error);
            loading.textContent = 'Could not load personal tags. Check the console for details.';
        }
    }

    function addNavigationButton() {
        const nav = $('ul.primary.navigation.actions') || $('ul.primary.navigation') || $('nav ul');
        if (!nav || $('#personal-tags-btn')) return;
        const li = document.createElement('li');
        const link = create('a', { href: '#', id: 'personal-tags-btn' }, 'Personal Tags');
        link.addEventListener('click', event => {
            event.preventDefault();
            showPersonalTagsModal();
        });
        li.appendChild(link);
        nav.appendChild(li);
    }

    function scheduleListingScan(root) {
        let queued = false;
        const scan = () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(() => {
                queued = false;
                addPersonalTagsToSearchResults(root).catch(error => {
                    console.error('[AO3 Personal Tags] Listing scan failed:', error);
                });
            });
        };

        scan();
        const target = $('#main') || document.body;
        const observer = new MutationObserver(records => {
            if (records.some(record => !record.target.closest?.('#personal-tags-section'))) scan();
        });
        observer.observe(target, { childList: true, subtree: true });
    }

    async function init() {
        try {
            await LocalStore.db();
            addStyles();
            addNavigationButton();

            if (/\/works\/\d+/.test(location.pathname)) {
                await addTagsToWorkPage();
                return;
            }

            if (/\/tags\/[^/]+\/works/.test(location.pathname)) {
                await addPersonalWorksToTagPage();
            }

            if (/\/works(?:\/search)?\/?$|\/search|\/bookmarks|\/series\/|\/collections\/|\/users\//.test(location.pathname)) {
                scheduleListingScan(document);
            }
        } catch (error) {
            console.error('[AO3 Personal Tags] Initialization failed:', error);
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
        init();
    }
})();
